GROQ_API_KEY=gsk_your_groq_api_key_here
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
TEMPA_DATA_DIR=./data
TEMPA_DAEMON_PORT=8787
# Native daemon + Docker WhatsApp bridge: bind on all interfaces so webhooks reach the daemon
TEMPA_BIND_HOST=0.0.0.0
TEMPA_WEBHOOK_BASE_URL=http://host.docker.internal:8787
# Public HTTPS URL via Cloudflare Tunnel (traveling laptop — no port-forward)
TEMPA_PUBLIC_BASE_URL=https://tempa.codenest.fun
# Dashboard CORS — use your public origin (not *)
TEMPA_CORS_ORIGIN=https://tempa.codenest.fun
# Free Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → Create)
# Then: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=tempa-evolution-key
# WhatsApp bridge instance name (services/whatsapp-bridge)
TEMPA_INSTANCE_NAME=tempa
# Auto-reply + reminders only to this number; add more in dashboard Connections → WhatsApp
WHATSAPP_OWNER_NUMBER=
# Slack (Socket Mode) — also enable App Home → Messages Tab (see README)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_OWNER_USER_ID=U01234567
# Optional comma-separated Slack user IDs allowed for private tools + Cursor coding
# (ignored when SLACK_ALLOW_ALL=true)
SLACK_ALLOWED_USER_IDS=
# When true, any Slack user can use private tools and Cursor coding — trusted workspace only
SLACK_ALLOW_ALL=false
# IANA timezone for calendar times, WhatsApp replies, and event creation (Islamabad = Asia/Karachi)
TEMPA_TIMEZONE=Asia/Karachi
# QA Agent — GitHub (choose one auth method)
# Option A: Personal Access Token (simplest — manage repos in dashboard QA tab)
GITHUB_TOKEN=
# Optional seed list; dashboard and chat approvals can add more at runtime
GITHUB_REPOS=
# Option B: GitHub App (webhooks; push auto-scan optional via qa.yaml — PRs are opt-in)
GITHUB_APP_ID=
# PEM contents or path outside the repo (never commit *.pem)
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
TEMPA_QA_ENABLED=true
TEMPA_QA_SCAN_INTERVAL_MINUTES=60
TEMPA_QA_MAX_BRANCHES_PER_REPO=50
TEMPA_QA_DEEP_REVIEW_MODE=lite
# Deep PR review prefers Cursor, then Claude, then Groq; all other QA tasks use Groq
CURSOR_API_KEY=
TEMPA_QA_CURSOR_MODEL=composer-2.5
# Interactive Tempa agent cwd (default: Tempa project root). Cursor SDK runs here with Tempa tools.
# TEMPA_AGENT_HOME=/home/olufsen/tempa
# Cursor Slack-thread jobs (parallel worktrees + CI-until-green)
TEMPA_CURSOR_PROGRESS_INTERVAL_SEC=120
TEMPA_CURSOR_JOB_TIMEOUT_SEC=7200
TEMPA_CURSOR_MAX_PARALLEL=8
TEMPA_CURSOR_CI_FIX_MAX=3
TEMPA_CURSOR_WORKTREE_ROOT=/repos/tempa-worktrees
# Comma-separated Slack user IDs pinged after 3 failed CI/fix cycles
TEMPA_CURSOR_ESCALATE_SLACK_IDS=
# Optional per-repo test secrets/context (agent uses when user asks to run tests)
# TEMPA_CURSOR_TEST_ENV_FILE=/repos/compliancetracker/.env.test
# Host path for Compliance Tracker (Docker mount → /repos/compliancetracker)
# COMPLIANCETRACKER_PATH=/home/olufsen/compliancetracker-main
# TEMPA_REPOS_HOST=./repos
# CLAUDE_CLI_BIN=/home/olufsen/.local/share/claude/versions/2.1.206
# CLAUDE_CONFIG_DIR=/home/olufsen/.claude
ANTHROPIC_API_KEY=
TEMPA_QA_CLAUDE_MODEL=claude-sonnet-4-20250514
# Tools coordinator: langgraph (default OrchestratorAgent) | hermes | varys (Claude merge hint)
# hermes = embed Hermes AIAgent for non-coding turns (pip install tempa[hermes]); Cursor still owns coding
TEMPA_COORDINATOR=langgraph
# Optional ADK spike — PARKED, keep off (prefer hermes)
TEMPA_ADK_SPIKE=false
TEMPA_HERMES_DISABLE_TERMINAL=true
TEMPA_HERMES_MAX_ITERATIONS=24
TEMPA_HERMES_CRON_ENABLED=false
# Hermes-style self-improvement: auto-create/refine skills + memory nudges after turns
TEMPA_SELF_IMPROVE=true
VARYS_ORCHESTRATOR_ENABLED=false
VARYS_TICK_SECONDS=270
VARYS_HARNESS_DB=./data/harness/harness.db
VARYS_VAULT_DIR=./data/vault
VARYS_AGENT_NAME=Tempa
VARYS_OWNER_NAME=
NOTION_API_KEY=
NOTION_HARNESS_DB_ID=
NOTION_ENABLED=false
# Jira Cloud — API token auth (dashboard Connections or env)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_ENABLED=false
JIRA_DEFAULT_PROJECT=
# Jira ticket bot — Slack + dashboard in-thread create/assign (all Slack users)
JIRA_TICKET_ENABLED=true
JIRA_TICKET_RATE_LIMIT=10
# Coolify — deploy teammate repos onto this host (Tempa → Coolify API)
# From inside Docker use host.docker.internal; on bare metal use http://127.0.0.1:8000
COOLIFY_BASE_URL=http://host.docker.internal:8000
COOLIFY_API_TOKEN=
COOLIFY_ENABLED=false
COOLIFY_SERVER_UUID=
COOLIFY_PROJECT_UUID=
COOLIFY_GITHUB_APP_UUID=
# Preferred for private repos (no GitHub App): Coolify SSH deploy key UUID
COOLIFY_DEPLOY_KEY_UUID=
# Base domain for app subdomains (e.g. codenest.fun → app.codenest.fun)
COOLIFY_WILDCARD_DOMAIN=
# Post-meeting notes: Slack DM + email to organizer and owner only (no WhatsApp / channel spam)
MEET_AUTO_SEND_SUMMARY_WHATSAPP=false
MEET_AUTO_SEND_SUMMARY_SLACK=true
MEET_AUTO_SEND_SUMMARY_EMAIL=true
# Calendar Meet auto-join poll interval (seconds); joins while meeting is still in progress
CALENDAR_POLL_SECONDS=120
# Team Punjab – Daily Sync also posts to this Slack channel (falls back to regionpunjab-internal)
MEET_PUNJAB_DAILY_SYNC_SLACK_CHANNEL=region-punjab
# Record Meet viewport as WebM (saved under data/meetings/{id}/video/)
MEET_RECORD_VIDEO=true
MEET_RECORD_VIDEO_WIDTH=1280
MEET_RECORD_VIDEO_HEIGHT=720
# System capture (meet-worker): FFmpeg X11 + PulseAudio → MP4 with audio + PCM for STT
MEET_SYSTEM_CAPTURE_ENABLED=true
MEET_SYSTEM_CAPTURE_FPS=30
MEET_PULSE_MONITOR_SOURCE=meet_sink_0.monitor
# Max simultaneous Meet sessions in meet-worker (1–16)
MEET_MAX_CONCURRENT=10
MEET_BROWSER_AUDIO_FALLBACK=false
MEET_VIRTUAL_CAMERA_ENABLED=true
MEET_VIRTUAL_CAMERA_PATH=config/assets/animated_tempa.mjpeg
# Dev/staging only: YouTube + screen-share A/V capture test (disabled in production)
MEET_AV_TEST_ENABLED=false
# Upload finalized meeting videos to YouTube (requires YouTube Data API v3 + Google reconnect)
MEET_YOUTUBE_UPLOAD_ENABLED=false
# private | unlisted (public is rejected)
MEET_YOUTUBE_PRIVACY=unlisted
MEET_CALENDAR_LOOKBACK_HOURS=12
CLAUDE_CODE_PATH=claude
# When true, Varys never falls back to Anthropic API — Claude Code CLI only
VARYS_CLAUDE_CLI_ONLY=true
